// first big step is: 0/Bit0 -> 0/Bit1
// second big step is: 0/Bit1 -> 0/Bit0, 1/Bit0 -> 1/Bit1 (two small steps)
// third big step: 1/Bit1 -> 1/Bit1, 2/Bit0 -> 2/Bit1
// etc
// n small steps, split into 1 smallstep,2smallstep,2smallstep,...,1smallstep = 2 + ((n-2)/2) big steps

// arrange the sister bits in a linear order
open util/ordering[PID] as PID

sig PID {}

state Counter {
	// external event that gets the process started
	env event Tk0 {}
	// event generated when it has counted through all the numbers	
	event Done {}
	current: one PID

	conc Bit [PID] {
		// internal event for a particular Bit
		event Tk1 {}

		default state Bit0 {
			trans Bit01 {
				when thisBit in current
				on Tk0
				goto Bit1
			}
		}
		
		state Bit1 {
			trans Bit10 {
				when {
					 thisBit in current
					 thisBit !in PID/last
				}
				on Tk0
				goto Bit0
				send Bit[PID/next[thisBit]]/Tk1
				do current' = PID/next[current]
			}
			trans LastBitDone {
				when {
					thisBit in current
					thisBit in PID/last
				}
				on Tk1
				goto Bit0
				send Done
			}
		}

		init {
			current = PID/first
		}
	}
}