abstract sig Response {} 
    
one sig Commit extends Response {} 
    
one sig Abort extends Response {} 
    
sig Key {} 
    
sig Value {} 
    
sig Transaction {
    coordinator : lone CoordinatorID, key : set Key set->set Value
} 
    
sig ClientID {} 
    
sig CoordinatorID {} 
    
sig PartLdrID {} 
    
fact {all t : one Transaction | one t.key}
    
default state Carousel {
    init {
             all disj p, q : one PartLdrID |
                 Carousel/PartitionLeader[p]/data =
                     Carousel/PartitionLeader[q]/data
             
             all disj p, q : one PartLdrID |
                 Carousel/PartitionLeader[p]/pendingTxn =
                     Carousel/PartitionLeader[q]/pendingTxn
         }
    
    default conc Client [ClientID] {
        response : lone Response
        
        data : set Key set->lone Value
        
        txn : lone Transaction
        
        transToSend : set Transaction
        
        init {
                 no Carousel/Client[p_Carousel_Client]/response
                 
                 some Carousel/Client[p_Carousel_Client]/data
                 
                 no Carousel/Client[p_Carousel_Client]/txn
             }
        
        default state Reading {
            trans ReadAndPrepare {
                from Carousel/Client/Reading[p_Carousel_Client]
                goto Carousel/Client/Waiting[p_Carousel_Client]
                when {
                    some c : one CoordinatorID |
                        no Carousel/Coordinator[c]/currentTxn
                }
                do {
                    one t : one Carousel/Client[p_Carousel_Client]/transToSend,
                        c : one CoordinatorID |
                        all leader : one PartLdrID |
                            {
                                Carousel/Client[p_Carousel_Client]/txn' = t
                                
                                Carousel/Coordinator[c]/client' =
                                    p_Carousel_Client
                                
                                no Carousel/Coordinator[c]/currentTxn
                                
                                Carousel/Coordinator[c]/currentTxn' = t
                                
                                t.coordinator = c
                                
                                add[
                                    Carousel/PartitionLeader[leader]/currentTxn,
                                    Carousel/PartitionLeader[leader]/currentTxn',
                                    t
                                ]
                                
                                Carousel/Client[p_Carousel_Client]/transToSend' =
                                    Carousel/Client[p_Carousel_Client]/transToSend -
                                        t
                                
                                all others : one CoordinatorID - c |
                                    Carousel/Coordinator[others]/client' =
                                        Carousel/Coordinator[others]/client
                                
                                all others : one CoordinatorID - c |
                                    Carousel/Coordinator[others]/currentTxn' =
                                        Carousel/Coordinator[others]/currentTxn
                            }
                }
            }
        }
        
        state Waiting {
            trans FinalizeCommit {
                from Carousel/Client/Waiting[p_Carousel_Client]
                goto Carousel/Client/Reading[p_Carousel_Client]
                when {
                    (one Carousel/Client[p_Carousel_Client]/response) and
                        Commit in Carousel/Client[p_Carousel_Client]/response
                }
                do {
                    Carousel/Client[p_Carousel_Client]/data' =
                        Carousel/Client[p_Carousel_Client]/txn.key
                    
                    Carousel/Client[p_Carousel_Client]/txn' = {none}
                    
                    no Carousel/Client[p_Carousel_Client]/response'
                }
            }
            
            trans FinalizeAbort {
                from Carousel/Client/Waiting[p_Carousel_Client]
                goto Carousel/Client/Reading[p_Carousel_Client]
                when {
                    (one Carousel/Client[p_Carousel_Client]/response) and
                        Abort in Carousel/Client[p_Carousel_Client]/response
                }
                do {
                    Carousel/Client[p_Carousel_Client]/txn' = {none}
                    
                    no Carousel/Client[p_Carousel_Client]/response'
                }
            }
        }
    }
    
    default conc Coordinator [CoordinatorID] {
        currentTxn : lone Transaction
        
        client : lone ClientID
        
        info : set Key set->lone Value
        
        coord_responses : set PartLdrID set->lone Response
        
        init {
                 no Carousel/Coordinator[p_Carousel_Coordinator]/client
                 
                 no Carousel/Coordinator[p_Carousel_Coordinator]/coord_responses
                 
                 no Carousel/Coordinator[p_Carousel_Coordinator]/info
                 
                 no Carousel/Coordinator[p_Carousel_Coordinator]/currentTxn
             }
        
        default state Replicate {
            trans Replicating {
                from Carousel/Coordinator/Replicate[p_Carousel_Coordinator]
                goto Carousel/Coordinator/WaitForResponse[p_Carousel_Coordinator]
                when {
                    one Carousel/Coordinator[p_Carousel_Coordinator]/currentTxn
                    }
                do {
                    Carousel/Coordinator[p_Carousel_Coordinator]/info' =
                        Carousel/Coordinator[p_Carousel_Coordinator]/currentTxn.
                            key
                }
            }
        }
        
        state WaitForResponse {
            trans StartAbort {
                from Carousel/Coordinator/WaitForResponse[p_Carousel_Coordinator]
                goto Carousel/Coordinator/WaitForResponse[p_Carousel_Coordinator]
                when {
                    (
                        some Carousel/Coordinator[p_Carousel_Coordinator]/coord_responses and
                            Abort in
                                PartLdrID.
                                    Carousel/Coordinator[p_Carousel_Coordinator]/coord_responses
                    )
                    }
                do {
                    Carousel/Client[Carousel/Coordinator[p_Carousel_Coordinator]/client]/response' =
                        Abort
                    
                    all others :
                            one ClientID -
                            Carousel/Coordinator[p_Carousel_Coordinator]/client |
                        Carousel/Client[others]/response' =
                            Carousel/Client[others]/response
                    
                    no Carousel/Coordinator[p_Carousel_Coordinator]/info' and
                        no Carousel/Coordinator[p_Carousel_Coordinator]/currentTxn' and
                        no Carousel/Coordinator[p_Carousel_Coordinator]/client' and
                        no Carousel/Coordinator[p_Carousel_Coordinator]/coord_responses'
                }
            }
            
            trans StartCommit {
                from Carousel/Coordinator/WaitForResponse[p_Carousel_Coordinator]
                goto Carousel/Coordinator/WaitForResponse[p_Carousel_Coordinator]
                when {
                    #Carousel/Coordinator[p_Carousel_Coordinator]/coord_responses =
                        #PartLdrID
                    
                    ! (
                        Abort in
                            PartLdrID.
                                Carousel/Coordinator[p_Carousel_Coordinator]/coord_responses
                    )
                }
                do {
                    Carousel/Client[Carousel/Coordinator[p_Carousel_Coordinator]/client]/response' =
                        Commit
                    
                    all others :
                            one ClientID -
                            Carousel/Coordinator[p_Carousel_Coordinator]/client |
                        Carousel/Client[others]/response' =
                            Carousel/Client[others]/response
                    
                    all leader : one PartLdrID |
                        Carousel/PartitionLeader[leader]/response' =
                            Carousel/Coordinator[p_Carousel_Coordinator]/currentTxn set->set
                                Commit
                    
                    no Carousel/Coordinator[p_Carousel_Coordinator]/info' and
                        no Carousel/Coordinator[p_Carousel_Coordinator]/currentTxn' and
                        no Carousel/Coordinator[p_Carousel_Coordinator]/client' and
                        no Carousel/Coordinator[p_Carousel_Coordinator]/coord_responses'
                }
            }
        }
    }
    
    default conc PartitionLeader [PartLdrID] {
        response : set Transaction set->lone Response
        
        data : set Key set->lone Value
        
        pendingTxn : buf[Transaction]
        
        currentTxn : buf[Transaction]
        
        init {
                 no Carousel/PartitionLeader[p_Carousel_PartitionLeader]/response
                 
                 one Carousel/PartitionLeader[p_Carousel_PartitionLeader]/pendingTxn
                 
                 no Carousel/PartitionLeader[p_Carousel_PartitionLeader]/currentTxn
             }
        
        default state Waiting {
            trans PrepareCommit {
                from Carousel/PartitionLeader/Waiting[p_Carousel_PartitionLeader]
                goto Carousel/PartitionLeader/Commit[p_Carousel_PartitionLeader]
                when {
                    (
                        some Carousel/PartitionLeader[p_Carousel_PartitionLeader]/currentTxn.
                                 elems and
                            no Carousel/PartitionLeader[p_Carousel_PartitionLeader]/response
                    )
                    
                    ! (
                        (
                            Carousel/PartitionLeader[p_Carousel_PartitionLeader]/currentTxn.
                                firstElem
                        ).
                            key.
                            Value in
                            (
                                Carousel/PartitionLeader[p_Carousel_PartitionLeader]/pendingTxn.
                                    elems.
                                    key
                            ).
                                Value
                    )
                }
                do {
                    add[
                        Carousel/PartitionLeader[p_Carousel_PartitionLeader]/pendingTxn,
                        Carousel/PartitionLeader[p_Carousel_PartitionLeader]/pendingTxn',
                        Carousel/PartitionLeader[p_Carousel_PartitionLeader]/currentTxn.
                            firstElem
                    ]
                    
                    removeFirst[
                        Carousel/PartitionLeader[p_Carousel_PartitionLeader]/currentTxn,
                        Carousel/PartitionLeader[p_Carousel_PartitionLeader]/currentTxn'
                    ]
                }
            }
            
            trans FinalizeCommit {
                from Carousel/PartitionLeader/Waiting[p_Carousel_PartitionLeader]
                goto Carousel/PartitionLeader/Waiting[p_Carousel_PartitionLeader]
                when {
                    (
                        Commit in
                            Transaction.
                                Carousel/PartitionLeader[p_Carousel_PartitionLeader]/response
                    )
                }
                do {
                    no Carousel/PartitionLeader[p_Carousel_PartitionLeader]/response'
                    
                    removeFirst[
                        Carousel/PartitionLeader[p_Carousel_PartitionLeader]/pendingTxn,
                        Carousel/PartitionLeader[p_Carousel_PartitionLeader]/pendingTxn'
                    ]
                    
                    Carousel/PartitionLeader[p_Carousel_PartitionLeader]/data' =
                        Carousel/PartitionLeader[p_Carousel_PartitionLeader]/data ++
                            (
                                Carousel/PartitionLeader[p_Carousel_PartitionLeader]/response.
                                    Response.
                                    key
                            )
                }
            }
            
            trans PrepareAbort {
                from Carousel/PartitionLeader/Waiting[p_Carousel_PartitionLeader]
                goto Carousel/PartitionLeader/Abort[p_Carousel_PartitionLeader]
                when {
                    some Carousel/PartitionLeader[p_Carousel_PartitionLeader]/currentTxn.
                             elems
                    
                    (
                        (
                            Carousel/PartitionLeader[p_Carousel_PartitionLeader]/currentTxn.
                                firstElem
                        ).
                            key.
                            Value in
                            (
                                Carousel/PartitionLeader[p_Carousel_PartitionLeader]/pendingTxn.
                                    elems.
                                    key
                            ).
                                Value
                    )
                }
            }
        }
        
        state Commit {
            trans CommitTransaction {
                from Carousel/PartitionLeader/Commit[p_Carousel_PartitionLeader]
                goto Carousel/PartitionLeader/Waiting[p_Carousel_PartitionLeader]
                do {
                    Carousel/Coordinator[(
    Carousel/PartitionLeader[p_Carousel_PartitionLeader]/pendingTxn.firstElem
).
    coordinator]/coord_responses' =
                        Carousel/Coordinator[(
    Carousel/PartitionLeader[p_Carousel_PartitionLeader]/pendingTxn.firstElem
).
    coordinator]/coord_responses +
                            (p_Carousel_PartitionLeader set->set Commit)
                    
                    all others :
                            one CoordinatorID -
                            (
                                Carousel/PartitionLeader[p_Carousel_PartitionLeader]/pendingTxn.
                                    firstElem
                            ).
                                coordinator |
                        Carousel/Coordinator[others]/coord_responses' =
                            Carousel/Coordinator[others]/coord_responses
                }
            }
        }
        
        state Abort {
            trans AbortTransaction {
                from Carousel/PartitionLeader/Abort[p_Carousel_PartitionLeader]
                goto Carousel/PartitionLeader/Waiting[p_Carousel_PartitionLeader]
                do {
                    removeFirst[
                        Carousel/PartitionLeader[p_Carousel_PartitionLeader]/currentTxn,
                        Carousel/PartitionLeader[p_Carousel_PartitionLeader]/currentTxn
                    ]
                    
                    Carousel/Coordinator[Carousel/PartitionLeader[p_Carousel_PartitionLeader]/currentTxn.
    firstElem.
    coordinator]/coord_responses' =
                        Carousel/Coordinator[Carousel/PartitionLeader[p_Carousel_PartitionLeader]/currentTxn.
    firstElem.
    coordinator]/coord_responses +
                            (p_Carousel_PartitionLeader set->set Abort)
                    
                    no Carousel/PartitionLeader[p_Carousel_PartitionLeader]/response'
                    
                    all others :
                            one CoordinatorID -
                            (
                                Carousel/PartitionLeader[p_Carousel_PartitionLeader]/pendingTxn.
                                    firstElem
                            ).
                                coordinator |
                        Carousel/Coordinator[others]/coord_responses' =
                            Carousel/Coordinator[others]/coord_responses
                }
            }
        }
    }
}