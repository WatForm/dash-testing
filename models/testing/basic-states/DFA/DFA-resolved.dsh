open util/boolean 
    
abstract sig Alphabet {} 
    
one sig A extends Alphabet {} 
    
one sig B extends Alphabet {} 
    
pred evens [
    word : set seq Alphabet
] {
    (#(word :> A)).rem[2] = 0
    
    (#(word :> B)).rem[2] = 0
}
    
check {
    evens[DshSnapshot/first.DFA_input] <=> isTrue[DshSnapshot/last.DFA_output]
}
    for exactly 8 DshSnapshot 
    
default state DFA {
    input : set seq Alphabet
    
    output : one Bool
    
    init {
             DFA/output = boolean/False
             
             ! DFA/input.isEmpty
         }
    
    default state S00 {
        trans onB {
            from DFA/S00
            goto DFA/S01
            when {
                first[DFA/input] = B
                }
            do {
                DFA/input' = DFA/input.rest
                }
        }
        
        trans onA {
            from DFA/S00
            goto DFA/S10
            when {
                first[DFA/input] = A
                }
            do {
                DFA/input' = DFA/input.rest
                }
        }
        
        trans accept {
            from DFA/S00
            goto DFA/S00
            when {
                DFA/input.isEmpty
                }
            do {
                DFA/output' = boolean/True
                }
        }
    }
    
    state S01 {
        trans onA {
            from DFA/S01
            goto DFA/S11
            when {
                first[DFA/input] = A
                }
            do {
                DFA/input' = DFA/input.rest
                }
        }
        
        trans onB {
            from DFA/S01
            goto DFA/S00
            when {
                first[DFA/input] = B
                }
            do {
                DFA/input' = DFA/input.rest
                }
        }
        
        trans reject {
            from DFA/S01
            goto DFA/S01
            when {
                DFA/input.isEmpty
                }
            do {
                DFA/output' = boolean/False
                }
        }
    }
    
    state S10 {
        trans reject {
            from DFA/S10
            goto DFA/S10
            when {
                DFA/input.isEmpty
                }
            do {
                DFA/output' = boolean/False
                }
        }
        
        trans onA {
            from DFA/S10
            goto DFA/S00
            when {
                first[DFA/input] = A
                }
            do {
                DFA/input' = DFA/input.rest
                }
        }
        
        trans onB {
            from DFA/S10
            goto DFA/S11
            when {
                first[DFA/input] = B
                }
            do {
                DFA/input' = DFA/input.rest
                }
        }
    }
    
    state S11 {
        trans onA {
            from DFA/S11
            goto DFA/S01
            when {
                first[DFA/input] = A
                }
            do {
                DFA/input' = DFA/input.rest
                }
        }
        
        trans reject {
            from DFA/S11
            goto DFA/S11
            when {
                DFA/input.isEmpty
                }
            do {
                DFA/output' = boolean/False
                }
        }
        
        trans onB {
            from DFA/S11
            goto DFA/S10
            when {
                first[DFA/input] = B
                }
            do {
                DFA/input' = DFA/input.rest
                }
        }
    }
}