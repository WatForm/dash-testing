state root {
	conc S1 {
		default state SP {}
		state SQ {}
	}
	conc S2 {
		default state SM {
			default state alpha {}
			state beta {}
		}
		state SN {}
	}

	trans t1 {
		// testing leaf-leaf transitions
		from alpha
		goto beta
	}

	trans t2 {
		// testing leaf-OR transitions
		from SN
		goto SM
	}

	trans t3 {
		// testing OR-leaf transitions
		from SM
		goto SN
	}

	trans t4 {
		// this is entirely within the S2 region
		from SP
		goto SQ
	}

	trans t5 {
		// testing AND-AND transitions, where AND states are siblings
		from S1
		goto S2
	}

	trans t6 {
		// testing AND-OR transitions
		from S1
		goto SM
	}

	trans t7 {
		// testing AND-leaf transitions
		from S1
		goto beta
	}

	trans t8 {
		// testing OR-AND transitions
		from SM
		goto S1
	}

	trans t9 {
		// testing AND-LEAF transitions
		from beta
		goto S1
	}

	trans t10 {
		// testing self-transitions
		from S1
		goto S1
	}
}